    "/score": {
      "post": {
        "summary": "Score Audio File",
        "description": "HTTP POST endpoint to score an uploaded audio file (WAV, FLAC, MP3, etc.) with full telemetry and optional telephony codec simulation.\nAccepts audio binary in either 'file' or 'audio' multipart form field.",
        "operationId": "score_audio_file_score_post",
        "parameters": [
          {
            "name": "codec",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
