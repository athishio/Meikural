  "components": {
    "schemas": {
      "AlertResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "risk_score": {
            "type": "number",
            "title": "Risk Score"
          },
          "sms": {
            "additionalProperties": true,
            "type": "object",
            "title": "Sms"
          },
          "email": {
            "additionalProperties": true,
            "type": "object",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "risk_score",
          "sms",
          "email"
        ],
        "title": "AlertResponse"
      },
      "AlertTriggerRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "risk_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Score"
          },
          "to_phone": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Phone"
          },
          "to_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "To Email"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "risk_score"
        ],
        "title": "AlertTriggerRequest"
      },
      "AntiSpoofingResult": {
        "properties": {
          "passive_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Passive Score",
            "description": "Passive spoof probability [0.0 - 1.0]",
            "example": 0.73
          },
          "verdict": {
            "$ref": "#/components/schemas/VerdictType",
            "description": "Categorical classification verdict",
            "example": "spoof"
          },
          "confidence": {
            "$ref": "#/components/schemas/ConfidenceLevel",
            "description": "Confidence level of classification",
            "example": "high"
          },
          "threshold_used": {
            "type": "number",
            "title": "Threshold Used",
            "description": "Decision threshold applied",
            "default": 0.5,
            "example": 0.5
          },
          "raw_logits": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raw Logits",
            "description": "[spoof_logit, bonafide_logit]",
            "example": [
              3.45,
              -2.1
            ]
          }
        },
        "type": "object",
        "required": [
          "passive_score",
          "verdict",
          "confidence"
        ],
        "title": "AntiSpoofingResult"
      },
      "AudioHealth": {
        "properties": {
          "is_speech": {
            "type": "boolean",
            "title": "Is Speech",
            "description": "Voice Activity Detection (VAD) flag",
            "example": true
          },
          "rms_db": {
            "type": "number",
            "title": "Rms Db",
            "description": "Audio signal root mean square energy in dB",
            "example": -24.5
          },
          "duration_ms": {
            "type": "number",
            "title": "Duration Ms",
            "description": "Audio chunk duration in milliseconds",
            "example": 4037.5
          }
        },
        "type": "object",
        "required": [
          "is_speech",
          "rms_db",
          "duration_ms"
        ],
        "title": "AudioHealth"
      },
      "Body_score_audio_file_score_post": {
        "properties": {
          "file": {
            "anyOf": [
              {
                "type": "string",
