    "/calls/{session_id}/verify": {
      "get": {
        "summary": "Verify Call Chain Endpoint",
        "description": "Verifies cryptographic hash-chain integrity across all telemetry events for a call session.\nWalks all sequential events and confirms sha256(prev_hash + session_id + timestamp + score + verdict).\nReturns verification status and the first tampered index if integrity is violated.\nNote: This is an appendable cryptographic hash-chain for tamper detection, not a distributed blockchain.",
        "operationId": "verify_call_chain_endpoint_calls__session_id__verify_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
