# ==============================================================================
# Meikural - Environment Variables Template
# Copy this file to .env and replace placeholder values with your credentials.
# ==============================================================================

# SMTP Email Alert Configuration (Gmail / Enterprise SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
ALERT_EMAIL_FROM=your-email@gmail.com
ALERT_EMAIL_TO=recipient@example.com

# Automated Threat Dispatch Safety Guard
# Set to 'false' (recommended during rehearsal/benchmarking) to prevent inbox flooding.
# Manual "Send Test Email (Live)" remains operational on demand regardless of this flag.
EMAIL_LIVE_DISPATCH=false

# Twilio Voice & SMS Configuration (Optional / Sandbox Simulation fallback)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550192834
VERIFIED_PHONE_NUMBER=+15550192834

# Security & Administrative API Access
MEIKURAL_API_KEY=your-admin-api-key
MEIKURAL_SALT=your-random-salt-here
DEMO_MODE=1
